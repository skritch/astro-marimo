---
type FrontMatter = {
  title: string;
  description?: string;
};
const notebooks: { frontmatter: FrontMatter; url: string; slug: string }[] =
  Object.values(
    import.meta.glob("./*.py", {
      eager: true,
      query: { pythonMetaOnly: true },
    }),
  );
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro + Marimo</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 640px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
      h1 {
        margin-bottom: 1rem;
      }
      ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      a {
        font-weight: 600;
      }
      .description {
        color: #6b7280;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <h1>Notebooks</h1>
    <ul>
      {
        Object.values(notebooks).map(({ frontmatter, url, slug }) => (
          <li>
            <a href={url}>{frontmatter.title ?? slug}</a>
            {frontmatter.description && (
              <span class="description"> — {frontmatter.description}</span>
            )}
          </li>
        ))
      }
    </ul>
  </body>
</html>
