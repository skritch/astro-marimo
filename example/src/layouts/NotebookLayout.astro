---
interface Props {
  frontmatter?: {
    title?: string;
    description?: string;
  };
  url: string;
  slug: string;
}
const props = Astro.props;
const frontmatter = props.frontmatter || {};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title || props.slug}</title>
    <style>
      body {
        display: flex;
        flex-direction: column;
      }
      header {
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid #e5e7eb;
        flex-shrink: 0;
        text-align: center;
      }
      h1 {
        font-size: 1.25rem;
        font-weight: 600;
      }
      p {
        font-size: 0.875rem;
        color: #6b7280;
        margin-top: 0.25rem;
      }
      /* Marimo's run-mode page padding (px-1 sm:px-16 md:px-20 xl:px-24, pb-24 sm:pb-12). */
      main { padding: 0 0.25rem 6rem; }
      @media (min-width: 640px) { main { padding: 0 4rem 3rem; } }
      @media (min-width: 768px) { main { padding-inline: 5rem; } }
      @media (min-width: 1280px) { main { padding-inline: 6rem; } }
    </style>
  </head>
  <body>
    <header>
      <h1>{frontmatter.title || props.slug}</h1>
      {frontmatter.description && <p>{frontmatter.description}</p>}
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
