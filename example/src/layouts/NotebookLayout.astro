---
interface Props {
  title?: string;
  [key: string]: unknown;
}
const { title = 'Notebook' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      * { margin: 0; box-sizing: border-box; }
      html, body { height: 100%; }
      body { display: flex; flex-direction: column; }
      header { padding: 0.75rem 1.5rem; border-bottom: 1px solid #e5e7eb; flex-shrink: 0; }
      main { flex: 1; overflow: hidden; }
      main :global(iframe) { width: 100%; height: 100%; border: none; display: block; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">astro-marimo</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
